# Copy this file to .env and fill in your own values. Never commit .env.

# Flagsmith: Organisation Settings -> API Keys -> "Create API Key"
# (Not needed when you use --use-cli: that uses your `flagsmith login` session and flagsmith.json.)
FLAGSMITH_API_KEY=
# The numeric project id (visible in the dashboard URL: /project/<id>/...)
FLAGSMITH_PROJECT_ID=
# Leave as-is for Flagsmith Cloud. For self-hosted use e.g. http://localhost:8000/api/v1
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1

# AI for `flagdoctor fix` - set ONE of these.
# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Or Google Gemini (has a free tier) from https://aistudio.google.com/apikey  (pip install -e ".[gemini]")
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
